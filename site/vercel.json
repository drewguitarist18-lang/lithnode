{
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.lithnode.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://lithnode.com/$1"
      }
    },
    {
      "src": "/shop/?",
      "has": [
        {
          "type": "host",
          "value": "lithnode.com"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://shop.lithnode.com/"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "shop.lithnode.com"
        }
      ],
      "dest": "/shop/index.html"
    },
    {
      "src": "/tiktok",
      "dest": "/index.html"
    },
    {
      "src": "/stats/?",
      "dest": "/api/stats"
    }
  ]
}
